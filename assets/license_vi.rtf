\qc\b\fs20\cf1 TH\u7886?A THU\u7852?N B\u7842?N QUY\u7872?N V\u192? \u272?I\u7872?U KHO\u7842?N S\u7916? D\u7908?NG\b0\par
\qc\b\fs20\cf1 PH\u7846?N M\u7872?M TXA WINSETUP (\u169? 2026 TXA STUDIO)\b0\par
\sa40\par
\ql\sa30\b\fs19\cf1 1. GI\u7898?I THI\u7878?U:\b0\par
\ql\sa20\b0\fs18\cf2 TXA WinSetup l\u224? ph\u7847?n m\u7873?m h\u7895? tr\u7907? c\u224?i \u273?\u7863?t Windows t\u7921? \u273?\u7897?ng, \u273?a n\u259?ng v\u224? t\u7889?c \u273?\u7897? cao, \u273?\u432?\u7907?c ph\u225?t tri\u7875?n v\u224? t\u7889?i \u432?u b\u7903?i TXA Studio. Ho\u7841?t \u273?\u7897?ng \u273?\u7897?c l\u7853?p c\u7843? trong m\u244?i tr\u432?\u7901?ng Windows v\u224? USB c\u7913?u h\u7897? WinPE.\par
\sa30\par
\ql\sa30\b\fs19\cf1 2. QUY\u7872?N S\u7916? D\u7908?NG:\b0\par
\ql\sa20\b0\fs18\cf2 \u8226? B\u7841?n \u273?\u432?\u7907?c ph\u233?p t\u7843?i v\u7873?, c\u224?i \u273?\u7863?t v\u224? s\u7917? d\u7909?ng mi\u7877?n ph\u237? cho m\u7909?c \u273?\u237?ch c\u225? nh\u226?n v\u224? k\u7929? thu\u7853?t.\par
\ql\sa20\b0\fs18\cf2 \u8226? B\u7841?n c\u243? quy\u7873?n t\u7841?o b\u7843?n sao, t\u237?ch h\u7907?p v\u224?o USB c\u7913?u h\u7897? ho\u7863?c ph\u432?\u417?ng ti\u7879?n l\u432?u tr\u7919? kh\u225?c \u273?\u7875? ph\u7909?c v\u7909? c\u224?i \u273?\u7863?t m\u225?y t\u237?nh.\par
\sa30\par
\ql\sa30\b\fs19\cf1 3. TR\u193?CH NHI\u7878?M V\u7872? D\u7918? LI\u7878?U:\b0\par
\ql\sa20\b0\fs18\cf2 \u8226? Qu\u225? tr\u236?nh ph\u226?n v\u249?ng ho\u7863?c \u273?\u7883?nh d\u7841?ng \u7893? \u273?\u297?a (Format) s\u7869? x\u243?a s\u7841?ch d\u7919? li\u7879?u tr\u234?n ph\u226?n v\u249?ng ho\u7863?c \u7893? \u273?\u297?a \u273?\u432?\u7907?c ch\u7885?n.\par
\ql\sa20\b0\fs18\cf2 \u8226? Ng\u432?\u7901?i d\u249?ng c\u243? tr\u225?ch nhi\u7879?m sao l\u432?u to\u224?n b\u7897? d\u7919? li\u7879?u quan tr\u7885?ng tr\u432?\u7899?c khi ti\u7871?n h\u224?nh c\u224?i \u273?\u7863?t.\par
\ql\sa20\b0\fs18\cf2 \u8226? T\u225?c gi\u7843? v\u224? TXA Studio kh\u244?ng ch\u7883?u tr\u225?ch nhi\u7879?m \u273?\u7889?i v\u7899?i b\u7845?t k\u7923? s\u7921? m\u7845?t m\u225?t d\u7919? li\u7879?u n\u224?o do vi\u7879?c ch\u7885?n nh\u7847?m \u7893? \u273?\u297?a.\par
\sa30\par
\ql\sa30\b\fs19\cf1 4. B\u7842?O H\u192?NH V\u192? H\u7894? TR\u7906?:\b0\par
\ql\sa20\b0\fs18\cf2 \u8226? Ph\u7847?n m\u7873?m \u273?\u432?\u7907?c cung c\u7845?p theo nguy\u234?n t\u7855?c "NGUY\u202?N B\u7842?N" (AS-IS), kh\u244?ng \u273?i k\u232?m b\u7845?t k\u7923? cam k\u7871?t ng\u7847?m \u273?\u7883?nh n\u224?o.\par
\ql\sa20\b0\fs18\cf2 \u8226? \u272?\u7875? b\u225?o l\u7895?i ho\u7863?c \u273?\u243?ng g\u243?p \u253? ki\u7871?n ph\u225?t tri\u7875?n, vui l\u242?ng li\u234?n h\u7879?: txasoftdev@gmail.com.\par
\sa30\par
\ql\sa30\i\fs18\cf3 B\u7857?ng vi\u7879?c t\u237?ch ch\u7885?n "T\u244?i \u273?\u7891?ng \u253?", b\u7841?n x\u225?c nh\u7853?n \u273?\u227? \u273?\u7885?c, hi\u7875?u r\u245? v\u224? ch\u7845?p thu\u7853?n to\u224?n b\u7897? c\u225?c \u273?i\u7873?u kho\u7843?n tr\u234?n.\i0\par
